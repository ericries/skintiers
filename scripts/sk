#!/usr/bin/env python3
"""SkinTiers CLI. Thin dispatch over sklib."""
import argparse
import collections
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import sklib  # noqa: E402


def cmd_status(args):
    posts = sklib.load_profiles(sklib.DATA_DIR)
    counts = collections.Counter(p.get("status", "unknown") for p in posts)
    for status in ("published", "draft", "flagged", "unknown"):
        if counts.get(status):
            print(f"{status}: {counts[status]}")
    print(f"total: {len(posts)}")
    return 0


def cmd_lint(args):
    import frontmatter
    path = sklib.find_profile(sklib.DATA_DIR, args.slug)
    if path is None:
        print(f"not found: {args.slug}", file=sys.stderr)
        return 1
    post = frontmatter.load(path)
    errors, warnings = sklib.check_profile(post.metadata, post.content)
    warnings = warnings + sklib.check_required_sections(post.metadata, post.content)
    for e in errors:
        print(f"ERROR: {e}")
    for w in warnings:
        print(f"WARN: {w}")
    if errors:
        return 1
    if warnings:
        return 2
    print(f"{args.slug}: clean")
    return 0


def cmd_verify(args):
    import frontmatter
    path = sklib.find_profile(sklib.DATA_DIR, args.slug)
    if path is None:
        print(f"not found: {args.slug}", file=sys.stderr)
        return 1
    post = frontmatter.load(path)
    errors, warnings = sklib.verify_profile(post.metadata, post.content)
    for e in errors:
        print(f"ERROR: {e}")
    for w in warnings:
        print(f"WARN: {w}")
    if errors:
        return 1
    if warnings:
        return 2
    print(f"{args.slug}: verified clean")
    return 0


def cmd_style(args):
    import frontmatter
    path = sklib.find_profile(sklib.DATA_DIR, args.slug)
    if path is None:
        print(f"not found: {args.slug}", file=sys.stderr)
        return 1
    post = frontmatter.load(path)
    warnings = sklib.check_style(post.content)
    for w in warnings:
        print(f"WARN: {w}")
    if warnings:
        return 2
    print(f"{args.slug}: clean style")
    return 0


def cmd_build(args):
    import subprocess
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    return subprocess.call([sys.executable, os.path.join(root, "build.py")])


def _set_and_build(slug, status, mark_analyzed=False):
    path = sklib.find_profile(sklib.DATA_DIR, slug)
    if path is None:
        print(f"not found: {slug}", file=sys.stderr)
        return 1
    sklib.set_status(path, status, mark_analyzed=mark_analyzed)
    print(f"{slug}: {status}")
    return cmd_build(None)


def cmd_publish(args):
    verdict = sklib.review_verdict(sklib.DATA_DIR, args.slug)
    if verdict != "publish" and not getattr(args, "force", False):
        print(
            f"refusing to publish {args.slug}: no passing critic review "
            f"(verdict=publish) in review-log.yaml — run a review first, or use --force",
            file=sys.stderr,
        )
        return 1
    rc = _set_and_build(args.slug, "published", mark_analyzed=True)
    if verdict == "publish":
        # A passing critic review means the sources were independently re-verified.
        path = sklib.find_profile(sklib.DATA_DIR, args.slug)
        if path is not None:
            sklib.set_assurance(path, "opus")
    else:
        if getattr(args, "force", False):
            print(f"WARN: force-published {args.slug} without a passing review")
    return rc


def cmd_draft(args):
    return _set_and_build(args.slug, "draft")


def _pending_sorted(type):
    items = [i for i in sklib.load_queue(sklib.DATA_DIR, type)
             if i.get("status") == "pending"]
    return sorted(items, key=lambda x: -x.get("priority", 0))


def cmd_queue_add(args):
    sklib.migrate_queue(sklib.DATA_DIR)
    if not getattr(args, "force", False) and \
            sklib.page_exists_for(sklib.DATA_DIR, args.name, args.type):
        print(f"skipped (page exists): {args.name}")
        return 0
    added = sklib.queue_add(sklib.DATA_DIR, args.name, args.type, args.priority,
                            args.discovered_from, args.source)
    print(f"{'added' if added else 'already queued'}: {args.name}")
    return 0


def _print_item(i):
    frm = i.get("discovered_from")
    suffix = f" (from {frm})" if frm else ""
    print(f"[{i.get('priority')}] {i.get('name')}{suffix}")


def cmd_queue(args):
    sklib.migrate_queue(sklib.DATA_DIR)
    if args.type:
        for i in _pending_sorted(args.type):
            _print_item(i)
        return 0
    total = 0
    for typ in sklib.QUEUE_TYPES:
        pending = _pending_sorted(typ)
        total += len(pending)
        print(f"== {typ} ==")
        if pending:
            for i in pending:
                _print_item(i)
        else:
            print("(empty)")
    print(f"total pending: {total}")
    return 0


def cmd_queue_resolve(args):
    sklib.migrate_queue(sklib.DATA_DIR)
    ok = sklib.queue_resolve(sklib.DATA_DIR, args.name, args.type)
    print(f"{'resolved' if ok else 'not found'}: {args.name}")
    return 0


def cmd_queue_next(args):
    sklib.migrate_queue(sklib.DATA_DIR)
    item = sklib.queue_next(sklib.DATA_DIR, args.type)
    if item is None:
        print(f"empty: {sklib.TYPE_TO_LIST[args.type]}")
        return 0
    if getattr(args, "json", False):
        import json
        print(json.dumps(item))
        return 0
    _print_item(item)
    return 0


def cmd_gate_check(args):
    counts = sklib.profile_counts(sklib.DATA_DIR, args.type)
    print(f"type: {args.type}")
    print(f"autopublish: {'true' if sklib.type_autopublishes(args.type) else 'false'}")
    print(f"published: {counts.get('published', 0)}")
    print(f"draft: {counts.get('draft', 0)}")
    print(f"stub: {counts.get('stub', 0)}")
    return 0


def cmd_queue_migrate(args):
    n = sklib.migrate_queue(sklib.DATA_DIR)
    print(f"migrated {n} items" if n else "nothing to migrate")
    return 0


def cmd_log(args):
    """Deprecated no-op. What's New is now auto-derived from each published page's
    `updated` date (git history is the changelog). Kept so existing cron `sk log`
    calls don't error; it records nothing."""
    print("noted (What's New is auto-derived from page dates; no changelog kept).")
    return 0


def cmd_audit(args):
    """Report drafted-but-unshipped work. Exit 1 if any hard leak (untracked
    file, or critic-cleared page still sitting as a draft)."""
    import subprocess
    import yaml

    root = sklib.ROOT
    try:
        out = subprocess.run(
            ["git", "-C", str(root), "ls-files", "data"],
            capture_output=True, text=True, check=True,
        ).stdout
        tracked = {str((root / line).resolve()) for line in out.split()}
    except Exception:
        tracked = set()
    log_path = root / "data" / "review-log.yaml"
    review_log = yaml.safe_load(log_path.read_text()) if log_path.exists() else {}

    report = sklib.audit_stuck(sklib.DATA_DIR, tracked, review_log)
    labels = {
        "untracked": "UNTRACKED (drafted, never committed — would vanish on clean checkout)",
        "stuck_publish": "STUCK (critic verdict 'publish' but still status:draft — ship-live leak)",
        "unreviewed_draft": "drafts in flight (no publish verdict yet)",
    }
    for key in ("untracked", "stuck_publish", "unreviewed_draft"):
        items = report[key]
        if items:
            print(f"\n{labels[key]} ({len(items)}):")
            for slug, extra in items:
                print(f"  - {slug}" + (f"  [{extra}]" if extra else ""))
    hard = len(report["untracked"]) + len(report["stuck_publish"])
    if not any(report.values()):
        print("clean: no drafted-but-unshipped work")
    else:
        print(f"\n{hard} hard leak(s), {len(report['unreviewed_draft'])} draft(s) in flight")
    return 1 if hard else 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="sk")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status").set_defaults(func=cmd_status)
    p_lint = sub.add_parser("lint")
    p_lint.add_argument("slug")
    p_lint.set_defaults(func=cmd_lint)
    p_verify = sub.add_parser("verify")
    p_verify.add_argument("slug")
    p_verify.set_defaults(func=cmd_verify)
    p_style = sub.add_parser("style")
    p_style.add_argument("slug")
    p_style.set_defaults(func=cmd_style)
    sub.add_parser("build").set_defaults(func=cmd_build)
    p_pub = sub.add_parser("publish")
    p_pub.add_argument("slug")
    p_pub.add_argument("--force", action="store_true")
    p_pub.set_defaults(func=cmd_publish)
    p_draft = sub.add_parser("draft")
    p_draft.add_argument("slug")
    p_draft.set_defaults(func=cmd_draft)
    _TYPES = ("product", "ingredient", "condition", "goal", "brand", "person", "study", "list")
    p_qa = sub.add_parser("queue-add")
    p_qa.add_argument("name")
    p_qa.add_argument("--type", required=True, choices=_TYPES)
    p_qa.add_argument("--priority", type=int, default=5)
    p_qa.add_argument("--from", dest="discovered_from", default=None)
    p_qa.add_argument("--source", default=None)
    p_qa.add_argument("--force", action="store_true",
                      help="queue even if a page with the derived slug already exists")
    p_qa.set_defaults(func=cmd_queue_add)
    p_q = sub.add_parser("queue")
    p_q.add_argument("--type", default=None, choices=_TYPES)
    p_q.set_defaults(func=cmd_queue)
    p_qr = sub.add_parser("queue-resolve")
    p_qr.add_argument("name")
    p_qr.add_argument("--type", default=None, choices=_TYPES)
    p_qr.set_defaults(func=cmd_queue_resolve)
    p_qn = sub.add_parser("queue-next")
    p_qn.add_argument("--type", required=True, choices=_TYPES)
    p_qn.add_argument("--json", action="store_true")
    p_qn.set_defaults(func=cmd_queue_next)
    p_gc = sub.add_parser("gate-check")
    p_gc.add_argument("--type", required=True, choices=_TYPES)
    p_gc.set_defaults(func=cmd_gate_check)
    sub.add_parser("queue-migrate").set_defaults(func=cmd_queue_migrate)
    sub.add_parser("audit").set_defaults(func=cmd_audit)
    p_log = sub.add_parser("log")
    p_log.add_argument("message")
    p_log.add_argument("--slug", default=None)
    p_log.add_argument("--date", default=None, help="YYYY-MM-DD; defaults to today")
    p_log.set_defaults(func=cmd_log)
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
